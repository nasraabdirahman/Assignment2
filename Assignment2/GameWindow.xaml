<Window x:Class="Assignment2.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment2"
        mc:Ignorable="d"
        Title="GameWindow" Height="450" Width="800">
    
	<Border BorderBrush="DimGray" BorderThickness="10" Background="Gray">
		<Grid>
			<Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
				<ColumnDefinition Width="150"/>
                <ColumnDefinition Width="30"/>
				<ColumnDefinition Width="auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
            <TextBox Foreground="LimeGreen"
                     Background="Gray"
                     BorderBrush="Gray"
                     FontFamily="Baskerville Old Face"
                     x:Name="player1"
                     Text="Player1"
                     HorizontalAlignment="Center"
                     Grid.Row="0"
                     Margin="0,4"
                     Grid.Column="1"
                     FontSize="24" />
            <TextBox Foreground="LimeGreen"
                     Background="Gray"
                     BorderBrush="Gray"
                     FontFamily="Baskerville Old Face"
                     x:Name="player2"
                     Text="Player2"
                     HorizontalAlignment="Center"
                     Grid.Row="2"
                     Margin="0,4"
                     Grid.Column="1"
                     FontSize="24" />
            <TextBlock Text="Tokens:"
                       FontFamily="Baskerville Old Face"
                       Grid.Row="1"
                       Margin="0,4"
                       Grid.Column="1"
                       FontSize="20"/>
            <TextBlock Text="Tokens:"
                   FontFamily="Baskerville Old Face"
                   Grid.Row="3"
                   Margin="0,4"
                   Grid.Column="1"
                   FontSize="20"/>
            <TextBox Foreground="Black"
                 Background="Gray"
                 BorderBrush="Gray"
                 FontFamily="Baskerville Old Face"
                 x:Name="player1NumOfTokens"
                 Text=""
                 HorizontalAlignment="Center"
                 Grid.Row="1"
                 Margin="0,4"
                 Grid.Column="1"
                 FontSize="20" />
            <TextBox Foreground="Black"
                 Background="Gray"
                 BorderBrush="Gray"
                 FontFamily="Baskerville Old Face"
                 x:Name="player2NumOfTokens"
                 Text=""
                 HorizontalAlignment="Center"
                 Grid.Row="3"
                 Margin="0,4"
                 Grid.Column="1"
                 FontSize="20" />
            
        </Grid>
    </Border>
</Window>
