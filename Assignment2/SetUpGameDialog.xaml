<Window x:Class="Assignment2.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment2"
        mc:Ignorable="d"
        Title="SetupGameDialog" Height="300" Width="450">

    <Border BorderBrush="DimGray" BorderThickness="10" Background="Gray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <TextBlock Foreground="LimeGreen"
                Text="Select Player" 
                Grid.ColumnSpan="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Grid.Row="0"
                FontSize="26" />
            <TextBlock Foreground="LimeGreen"
                HorizontalAlignment="Center"
                Text="Player 1" 
                Grid.Column="1"
                Grid.Row="1"
                FontSize="26"/>
            <TextBlock Foreground="LimeGreen"
                HorizontalAlignment="Center"
                Text="Player 2" 
                Grid.Column="3"
                Grid.Row="1"
                FontSize="26"/>
            <TextBlock Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="Insert Name of Player 1:" 
                Grid.Column="1"
                Grid.Row="2"/>
            <TextBlock Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="Insert name of Player 2:" 
                Grid.Column="3"
                Grid.Row="2"/>
            <TextBox x:Name="playerOneName" 
                     BorderBrush="DimGray" 
                     BorderThickness="3"
                     Background="Gray" 
                     HorizontalAlignment="Right" 
                     Grid.Column="1" Grid.Row="2" 
                     Width="60"/>
            <TextBox x:Name="playerTwoName" 
                     BorderBrush="DimGray"
                     BorderThickness="3"
                     Background="Gray" 
                     HorizontalAlignment="Right" 
                     Grid.Column="3" Grid.Row="2" 
                     Width="60"/>
            <TextBlock Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="10,0"
                Text="Computer Player" 
                Grid.Column="3"
                Grid.Row="3"/>
            <TextBlock Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="10,0"
                Text="Computer Player" 
                Grid.Column="1"
                Grid.Row="3"/>
            <TextBlock Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="10,0"
                Text="Human Player" 
                Grid.Column="3"
                Grid.Row="4"/>
            <TextBlock Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="10,0"
                Text="Human Player" 
                Grid.Column="1"
                Grid.Row="4"/>
            
        </Grid>
    </Border>
</Window>