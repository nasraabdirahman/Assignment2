<Window x:Class="Assignment2.View.WinnerDialogxaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment2.View"
        mc:Ignorable="d"
        Title="WinnerDialogxaml" Height="200" Width="250">
    <Border BorderBrush="DimGray" BorderThickness="10" Background="Gray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="2" HorizontalAlignment="Center" Text="Congratulations!" Foreground="LimeGreen"
                        FontFamily="Baskerville Old Face" FontSize="28"/>
            <TextBlock Grid.ColumnSpan="2" HorizontalAlignment="Center" Text="Name" Foreground="LimeGreen"
                        FontFamily="Baskerville Old Face" FontSize="22" Grid.Row="1"/>
            <TextBlock x:Name="winnerTokens" Grid.ColumnSpan="2" HorizontalAlignment="Center" Text="" Foreground="LimeGreen"
                        FontFamily="Baskerville Old Face" FontSize="18" Grid.Row="2"/>
            <Button x:Name="newGame" Content="New Game" Grid.ColumnSpan="2" Grid.Row="3" Margin="20,5" 
                    FontFamily="Baskerville Old Face" BorderBrush="DimGray" BorderThickness="2"/>
        </Grid>
    </Border>
</Window>
