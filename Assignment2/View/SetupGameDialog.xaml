<Window x:Class="Assignment2.View.SetupGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment2"
        mc:Ignorable="d"
        FontSize="26"
        Title="SetupGameDialog" Height="500" Width="800">
    <Window.Resources>
        <Style x:Key="ButtonSize" TargetType="RadioButton">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Bullet" Width="15" Height="15" Stroke="White" StrokeThickness="2" Fill="White"/>
                            <ContentPresenter Margin="10,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="DimGray" BorderThickness="10" Background="Gray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
            <TextBlock Foreground="LimeGreen"
                FontFamily="Baskerville Old Face"
                Text="Select Player:" 
                Grid.ColumnSpan="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Grid.Row="0"
                FontSize="56" />
            <TextBlock Foreground="LimeGreen"
                HorizontalAlignment="Center"
                FontFamily="Baskerville Old Face"
                Text="Player 1" 
                Grid.Column="1"
                Grid.Row="1"
                FontSize="46"/>
            <TextBlock Foreground="LimeGreen"
                HorizontalAlignment="Center"
                FontFamily="Baskerville Old Face"
                Text="Player 2" 
                Grid.Column="3"
                Grid.Row="1"
                FontSize="46"/>
            <TextBlock Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="Insert Name of Player 1:" 
                Grid.Column="1"
                Grid.Row="2"/>
            <TextBlock Foreground="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="Insert name of Player 2:" 
                Grid.Column="3"
                Grid.Row="2"/>
            <TextBox x:Name="playerOneName" 
                     BorderBrush="DimGray" 
                     BorderThickness="4"
                     Background="Gray" 
                     HorizontalAlignment="Right" 
                     Grid.Column="1" Grid.Row="2" 
                     Width="90"/>
            <TextBox x:Name="playerTwoName" 
                     BorderBrush="DimGray"
                     BorderThickness="4"
                     Background="Gray" 
                     HorizontalAlignment="Right" 
                     Grid.Column="3" Grid.Row="2" 
                     Width="90"/>
            <RadioButton Content = "Computer Player" Foreground="White" Margin="10,0" GroupName="PlayerTypeOne" Grid.Column="1" Grid.Row="3" Checked="RadioButton_Checked" Style="{StaticResource ButtonSize}"/>
            <RadioButton Content="Human Player" Foreground="White" Margin="10,0" GroupName="PlayerTypeOne" Grid.Column="1" Grid.Row="4" Checked="RadioButton_Checked" Style="{StaticResource ButtonSize}"/>

            <RadioButton Content="Computer Player" Foreground="White" Margin="10,0" GroupName="PlayerTypeTwo" Grid.Column="3" Grid.Row="3" Checked="RadioButton_Checked" Style="{StaticResource ButtonSize}"/>
            <RadioButton Content="Human Player" Foreground="White" Margin="10,0" GroupName="PlayerTypeTwo" Grid.Column="3" Grid.Row="4" Checked="RadioButton_Checked" Style="{StaticResource ButtonSize}"/>
            <Button x:Name="Start" Content="Start" Grid.ColumnSpan="3" Margin="50,0"  Grid.Column="1" Grid.Row="6" 
                    BorderBrush="DimGray" 
                    BorderThickness="3"
                    Background="LightGray" 
                    Foreground="Black"
                    FontFamily="Baskerville Old Face"
                    FontSize="46"
                    Click="Button_Clicked"/>    
        </Grid>
    </Border>
</Window>